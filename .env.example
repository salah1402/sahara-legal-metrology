# =============================================================================
# SAHARA — Legal Metrology Inspection System
# Production Environment Configuration Template
# Copy to .env and provide your deployment-specific values.
# =============================================================================

# --- Backend Server Configuration ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Security & CORS ---
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://sahara.example.com

# --- AI & Cloud API Keys ---
# NVIDIA API key for Nemotron 3 Ultra 550B semantic normalization & executive summary
# Obtain key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# --- Storage Configuration ---
# Path for storing uploaded images, OCR JSONs, and PDF inspection reports
STORAGE_DIR=backend/inspections
MAX_UPLOAD_SIZE_MB=25

# --- Frontend Build Configuration (Vite) ---
# Set the backend URL for the frontend build (leave empty for same-host /api proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
