{
  "rule_id": "PCR-2011-R6-1-b",
  "rule_number": "6(1)(b)",
  "title": "Common or Generic Name of the Commodity",
  "description": "The common or generic names of the commodity contained in the package and in case of packages with more than one product, the name and number or quantity of each product shall be mentioned on the package.",
  "status": "enacted",
  "source": {
    "instrument": "Legal Metrology (Packaged Commodities) Rules, 2011",
    "notification": "G.S.R. 202(E)",
    "effective_from": "2011-04-01",
    "source_type": "official_gazette",
    "source_url": "https://consumeraffairs.nic.in"
  },
  "applicability": {
    "package_category": ["retail", "group", "combination", "multi_piece"],
    "exempt_under_rule_26": false
  },
  "requirements": {
    "declaration_type": "commodity_generic_name",
    "distinguish_from_brand": true
  },
  "evaluator": {
    "handler": "evaluate_commodity_name"
  },
  "evidence_requirements": {
    "fields": ["commodity_name"]
  }
}
