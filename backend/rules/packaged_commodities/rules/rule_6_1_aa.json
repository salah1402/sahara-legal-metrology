{
  "rule_id": "PCR-2011-R6-1-aa",
  "rule_number": "6(1)(aa)",
  "title": "Country of Origin / Manufacture (Imported Commodities)",
  "description": "The name of the country of origin or manufacture or assembly in case of imported products shall be mentioned on the package.",
  "status": "enacted",
  "source": {
    "instrument": "Legal Metrology (Packaged Commodities) Amendment Rules, 2017",
    "notification": "G.S.R. 779(E)",
    "effective_from": "2018-01-01",
    "source_type": "official_gazette",
    "source_url": "https://consumeraffairs.nic.in"
  },
  "applicability": {
    "is_imported": true,
    "exempt_under_rule_26": false
  },
  "requirements": {
    "declaration_type": "country_of_origin",
    "required_when_imported": true
  },
  "evaluator": {
    "handler": "evaluate_country_of_origin"
  },
  "evidence_requirements": {
    "fields": ["country_of_origin", "importer"]
  }
}
