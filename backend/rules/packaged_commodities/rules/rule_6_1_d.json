{
  "rule_id": "PCR-2011-R6-1-d",
  "rule_number": "6(1)(d)",
  "title": "Month & Year of Manufacture / Packing / Import",
  "description": "The month and the year in which the commodity is manufactured or pre-packed or imported shall be clearly indicated on the package.",
  "status": "enacted",
  "source": {
    "instrument": "Legal Metrology (Packaged Commodities) Rules, 2011",
    "notification": "G.S.R. 202(E) amended by G.S.R. 784(E)",
    "effective_from": "2011-04-01",
    "source_type": "official_gazette",
    "source_url": "https://consumeraffairs.nic.in"
  },
  "applicability": {
    "package_category": ["retail", "group", "combination", "multi_piece"],
    "exempt_under_rule_26": false
  },
  "requirements": {
    "declaration_type": "mfg_or_packing_date",
    "minimum_precision": "month"
  },
  "evaluator": {
    "handler": "evaluate_manufacturing_or_packing_date"
  },
  "evidence_requirements": {
    "fields": ["manufacturing_date", "packing_date"]
  }
}
