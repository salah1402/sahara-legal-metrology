{
  "rule_id": "PCR-2011-R6-1-c",
  "rule_number": "6(1)(c)",
  "title": "Net Quantity in Standard Metric Units",
  "description": "The net quantity, in terms of the standard unit of weight or measure, of the commodity contained in the package or where the commodity is packed or sold by number, the number of the commodity contained in the package shall be mentioned.",
  "status": "enacted",
  "source": {
    "instrument": "Legal Metrology (Packaged Commodities) Rules, 2011",
    "notification": "G.S.R. 202(E) read with Rule 12 & Rule 13",
    "effective_from": "2011-04-01",
    "source_type": "official_gazette",
    "source_url": "https://consumeraffairs.nic.in"
  },
  "applicability": {
    "package_category": ["retail", "wholesale", "group", "combination", "multi_piece"],
    "exempt_under_rule_26": false
  },
  "requirements": {
    "declaration_type": "net_quantity",
    "permitted_units": ["g", "kg", "mg", "mL", "L", "cm", "m", "mm", "units", "pieces", "N"],
    "numerical_value_required": true,
    "standard_unit_required": true
  },
  "evaluator": {
    "handler": "evaluate_net_quantity"
  },
  "evidence_requirements": {
    "fields": ["net_quantity", "number_of_items"]
  }
}
