{
  "rule_id": "PCR-2011-R6-1-e",
  "rule_number": "6(1)(e)",
  "title": "Maximum Retail Price (MRP inclusive of all taxes)",
  "description": "The retail sale price of the package shall clearly indicate that it is the maximum retail price inclusive of all taxes, stated in Indian Rupees (INR / Rs. / ₹).",
  "status": "enacted",
  "source": {
    "instrument": "Legal Metrology (Packaged Commodities) Rules, 2011",
    "notification": "G.S.R. 202(E) read with G.S.R. 784(E)",
    "effective_from": "2011-04-01",
    "source_type": "official_gazette",
    "source_url": "https://consumeraffairs.nic.in"
  },
  "applicability": {
    "package_category": ["retail", "group", "combination", "multi_piece"],
    "exempt_under_rule_26": false
  },
  "requirements": {
    "declaration_type": "maximum_retail_price",
    "currency": "INR",
    "must_be_inclusive_of_taxes": true,
    "no_dual_conflicting_mrp": true
  },
  "evaluator": {
    "handler": "evaluate_mrp"
  },
  "evidence_requirements": {
    "fields": ["mrp"]
  }
}
